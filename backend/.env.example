# Copy this file to .env and fill in the real values.
# DO NOT commit the real .env file.

# ── API ──────────────────────────────────────────────────────────────────────
PROJECT_NAME="Learning Management System"
API_V1_STR="/api/v1"

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces). No wildcards with credentials.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL used for email links and CORS fallback
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lms

# ── SMTP / Email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME="LMS Support"

# ── Admin seed ───────────────────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-strong-password

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Options: memory, redis. Defaults to memory.
RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=52428800

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Storage provider ─────────────────────────────────────────────────────────
# Options: local, s3, r2, minio
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=
CLOUDFRONT_URL=

# ── Cloudinary ───────────────────────────────────────────────────────────────
# For signed uploads, provide all four values. For unsigned uploads, provide
# cloud_name and upload_preset only (less secure, not recommended for production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
